<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Siempre claro (decisión 92): sin DayNight y sin que el sistema oscurezca la app. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- El fondo de la app: es lo que se ve detrás de la barra de estado y de la de gestos. -->
        <item name="android:windowBackground">@color/ground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Hasta Android 11, la pantalla de inicio es esta imagen: el logo al centro sobre el
             fondo de la app. Desde Android 12 la arma el sistema con el ícono de la app, sobre
             el color de abajo. -->
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ground</item>
    </style>
</resources>