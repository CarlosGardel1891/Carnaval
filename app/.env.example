# Copiá este archivo a .env y completalo. Nunca subas .env al repo.
# Supabase local: `pnpm supabase status` muestra la URL y la publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# Key gratuita de https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=
# Avisos push: dejalo vacío hasta tener Firebase configurado (ver «Avisos push» en CLAUDE.md).
# Con 1, la app carga el plugin de push; sin app/android/app/google-services.json, falla.
VITE_PUSH_ENABLED=
