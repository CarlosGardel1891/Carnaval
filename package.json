{
  "name": "cuerda",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter app dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @cuerda/db-tests test:db",
    "gen:seed": "python scripts/gen_seed.py",
    "gen:assets": "python scripts/gen_splash.py && pnpm --filter app exec capacitor-assets generate --ios --android --assetPath assets && python scripts/gen_splash.py --android-layers",
    "db:grilla": "node scripts/db-grilla.mjs",
    "db:noche-real": "node scripts/db-grilla.mjs --real",
    "db:fixture": "node scripts/db-grilla.mjs --fixture",
    "db:llamadas": "node scripts/db-grilla.mjs --llamadas",
    "admin:alta": "node scripts/admin-user.mjs alta",
    "admin:baja": "node scripts/admin-user.mjs baja",
    "admin:lista": "node scripts/admin-user.mjs lista",
    "remoto:chequeo": "node scripts/remoto-chequeo.mjs",
    "gen:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
