# Copiá este archivo a .env y completalo. Nunca subas .env al repo.
# Supabase local: `pnpm supabase status` muestra la URL y la publishable key.
# El panel usa la key pública y la sesión del admin. La service role NO va acá ni en ningún
# archivo del panel: todo lo que empieza con VITE_ termina dentro del sitio publicado.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# La misma key de MapTiler de la app, para ubicar escenarios en el mapa y buscar direcciones.
# Sumá http://localhost:5174 y el dominio del panel a sus orígenes permitidos.
VITE_MAPTILER_KEY=
